# Solo Agency OS — Environment Variables
# Copy this file to .env.local and fill in the values

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Super Admin ───
SUPER_ADMIN_EMAIL=your_email@example.com

# ─── Resend (Transactional Email) ───
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Stripe (Subscription Billing) ───
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_monthly_price_id

# ─── Google PageSpeed Insights ───
# Optional: agency owners can also set their own key in Settings
GOOGLE_PAGESPEED_API_KEY=your_google_api_key

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
